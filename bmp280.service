[Unit]
Description=BMP280 HomeKit temperature sensor
Documentation=https://github.com/seriousm4x/bmp280-homekit
After=local-fs.target

[Service]
Type=simple
User=bmp280
Group=bmp280
WorkingDirectory=/opt/bmp280-homekit
ExecStart=/opt/bmp280-homekit/bmp280
Restart=on-failure
RestartSec=5s

# The application uses ./db for HomeKit pairing data. Because the working
# directory is fixed above, this resolves to /opt/bmp280-homekit/db.

# Required for access to /dev/i2c-1 on typical Linux installations.
SupplementaryGroups=i2c

[Install]
WantedBy=multi-user.target
